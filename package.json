{
  "name": "ai-reflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "concurrently -k -n server,worker,web -c blue,green,magenta \"pnpm dev:server\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @ai-reflow/web dev",
    "dev:server": "pnpm --filter @ai-reflow/server dev",
    "dev:worker": "pnpm --filter @ai-reflow/worker dev",
    "build": "pnpm --filter @ai-reflow/web build",
    "typecheck": "pnpm --filter @ai-reflow/web typecheck",
    "typecheck:server": "pnpm --filter @ai-reflow/server typecheck",
    "typecheck:worker": "pnpm --filter @ai-reflow/worker typecheck",
    "preview": "pnpm --filter @ai-reflow/web preview",
    "smoke": "node scripts/smoke.mjs",
    "test:workspace": "node --test scripts/workspace-check.test.mjs",
    "db:migrate": "tsx --env-file=.env packages/platform/src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env packages/platform/src/db/seed.ts",
    "test:api": "tsx --env-file=.env scripts/api-integration.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
