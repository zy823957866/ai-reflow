{
  "name": "ai-reflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "concurrently -k -n server,worker,web -c blue,green,magenta \"pnpm dev:server\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx --tsconfig apps/server/tsconfig.json --env-file=.env apps/server/src/main.ts",
    "dev:worker": "tsx --env-file=.env apps/worker/src/main.ts",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:server": "tsc -p apps/server/tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p apps/worker/tsconfig.json --noEmit",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "tsx --env-file=.env packages/platform/src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env packages/platform/src/db/seed.ts",
    "test:api": "tsx --env-file=.env scripts/api-integration.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@unocss/reset": "^66.13.0",
    "@vueuse/core": "^15.1.0",
    "@xyflow/vue": "2.0.2",
    "lucide-vue-next": "0.545.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "unocss": "^66.13.0",
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vue-tsc": "3.3.14"
  }
}
