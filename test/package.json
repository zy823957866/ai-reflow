{
  "name": "@ai-reflow/test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test --test-reporter spec \"capabilities/**/*.test.ts\" \"platform/**/*.test.ts\" \"server/**/*.test.ts\" \"web/**/*.test.ts\" \"worker/**/*.test.ts\"",
    "test:capabilities": "tsx --test --test-reporter spec \"capabilities/**/*.test.ts\"",
    "test:platform": "tsx --test --test-reporter spec \"platform/**/*.test.ts\"",
    "test:server": "tsx --test --test-reporter spec \"server/**/*.test.ts\"",
    "test:worker": "tsx --test --test-reporter spec \"worker/**/*.test.ts\"",
    "test:workspace": "node --test workspace/workspace-check.test.mjs"
  },
  "dependencies": {
    "@ai-reflow/capabilities": "workspace:*",
    "@ai-reflow/core": "workspace:*",
    "@ai-reflow/engine": "workspace:*",
    "@ai-reflow/platform": "workspace:*",
    "@langchain/core": "^1.5.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "docx": "^9.16.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.6",
    "xlsx": "^0.18.5"
  }
}
