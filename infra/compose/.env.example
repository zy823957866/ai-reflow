# 复制为 infra/compose/.env 后修改。密码建议只使用字母和数字，避免 URL 转义问题。
POSTGRES_DB=ai_reflow
POSTGRES_USER=ai_reflow
POSTGRES_PASSWORD=replace-with-a-strong-password

REDIS_PASSWORD=replace-with-another-strong-password

DEFAULT_WORKSPACE_ID=00000000-0000-7000-8000-000000000001
DEFAULT_WORKSPACE_SLUG=demo
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WORKER_POLL_INTERVAL_MS=350

# 对外访问地址；使用 VM 的局域网地址时，例如 http://192.168.1.20:8080。
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080

# worker 调用 OpenAI 兼容模型时使用，可留空。
AI_REFLOW_MODEL_API_KEY=
OPENAI_API_KEY=

