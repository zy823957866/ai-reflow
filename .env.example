# 仅复制为 .env，不要把真实密码提交到仓库。
DATABASE_URL=postgresql://postgres:<local-password>@127.0.0.1:5432/postgres
API_HOST=127.0.0.1
API_PORT=8787
DEFAULT_WORKSPACE_ID=00000000-0000-7000-8000-000000000001
DEFAULT_WORKSPACE_SLUG=demo
ENCRYPTION_KEY=change-me-to-a-32-byte-secret
WEB_ORIGIN=http://127.0.0.1:5173
QUEUE_MODE=database
WORKER_POLL_INTERVAL_MS=350

# 本地对象存储示例；使用外部 S3 时替换 endpoint、region 和凭证。
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ai-reflow
S3_ACCESS_KEY_ID=ai-reflow
S3_SECRET_ACCESS_KEY=replace-with-a-strong-minio-secret
S3_FORCE_PATH_STYLE=true
