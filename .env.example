# 仅复制为 .env，不要把真实密码提交到仓库。
DATABASE_URL=postgresql://postgres:<local-password>@127.0.0.1:5432/postgres
API_HOST=127.0.0.1
API_PORT=8787
DEFAULT_WORKSPACE_ID=00000000-0000-7000-8000-000000000001
DEFAULT_WORKSPACE_SLUG=demo
ENCRYPTION_KEY=change-me-to-a-32-byte-secret
WEB_ORIGIN=http://127.0.0.1:5173
QUEUE_MODE=database
WORKER_POLL_INTERVAL_MS=350
OBJECT_STORAGE_PATH=.data/object-storage
# Rerank：ollama 使用对话模型做 LLM 精排；http 连接 Cohere 兼容的 rerank 接口。
RERANK_PROVIDER=ollama
RERANK_MODEL=qwen3.5:latest
RERANK_BASE_URL=http://127.0.0.1:11434
RERANK_TIMEOUT_MS=60000
# Ollama 对话模型使用小批量精排，避免长提示词导致响应变慢或为空。
RERANK_BATCH_SIZE=8
RERANK_MAX_TEXT_CHARS=400
